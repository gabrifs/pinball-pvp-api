# ── .env.example ──────────────────────────────────────────────────────────────
# Template for the secrets file that lives on the host OUTSIDE the git checkout.
# Copy this file to the location you configure as DEPLOY_ENV_FILE in your
# GitHub Actions repository variables, then fill in the real values.
# Never commit the real .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── CI-managed (set by the deploy job; NOT in the host .env file) ─────────────
# IMAGE_TAG and GITHUB_REPOSITORY are injected by the GitHub Actions deploy job.
# They are documented here for reference only; do not set them in the host file.
#   IMAGE_TAG=sha-<short-sha>          (e.g. sha-1a2b3c4)
#   GITHUB_REPOSITORY=owner/repo       (e.g. gabrifs/pinball-pvp-api)

# ── PostgreSQL (db service) ───────────────────────────────────────────────────
POSTGRES_DB=pinballpvp
POSTGRES_USER=pinball
POSTGRES_PASSWORD=change-me

# ── Application connection string ─────────────────────────────────────────────
# Host must match the db service name in docker-compose.yml.
ConnectionStrings__DefaultConnection=Host=db;Database=pinballpvp;Username=pinball;Password=change-me

# ── JWT ───────────────────────────────────────────────────────────────────────
# Key must be at least 32 characters (256 bits) for HMAC-SHA256.
# Issuer and Audience must match the values embedded in deployed game client builds.
Jwt__Key=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__Issuer=PinballPVP.Api
Jwt__Audience=PinballPVP.Client
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=30

# ── Email (SMTP / STARTTLS) ───────────────────────────────────────────────────
Email__Host=smtp.example.com
Email__Port=587
Email__FromAddress=noreply@example.com
Email__FromName=PinballPVP
Email__Username=noreply@example.com
Email__Password=change-me

# ── CORS ──────────────────────────────────────────────────────────────────────
# Required for Unity WebGL clients; omit (leave blank) if there is no web client.
# Add __1, __2, … for additional origins.
Cors__AllowedOrigins__0=

# ── Optional overrides (defaults shown) ───────────────────────────────────────
Leaderboard__WinRateMinMatches=10
Maintenance__PurgeIntervalHours=24
PasswordRecovery__ExpirationMinutes=15
